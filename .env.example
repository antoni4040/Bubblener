# Keys for the live provider tests: `npm run test:live`
#
#   cp .env.example .env.local     # .env.local is gitignored — never commit keys
#   # fill in whichever providers you want to exercise, then:
#   npm run test:live
#
# Each provider is INDEPENDENT. A test suite skips itself when its variable is
# absent, so filling in a single key is perfectly normal — that provider runs
# and the rest report "skipped". The run prints which is which before it starts.
#
# These variables are used ONLY by the live test suite. The extension itself
# always reads the key from browser storage and never sees this file.
#
# Cost: one full run per provider is about five short requests (a two-sentence
# passage, three entities) — a fraction of a cent.


# Google AI Studio → https://aistudio.google.com/apikey
BUBBLENER_GEMINI_KEY=

# OpenAI dashboard → https://platform.openai.com/api-keys
BUBBLENER_OPENAI_KEY=

# DeepSeek dashboard → https://platform.deepseek.com/api_keys
BUBBLENER_DEEPSEEK_KEY=


# Ollama runs locally and needs no key — set to 1 once `ollama serve` is up.
# The extension talks to it from a chrome-extension:// origin, so you may also
# need:  OLLAMA_ORIGINS='chrome-extension://*' ollama serve
BUBBLENER_OLLAMA=

# Optional: a model you have actually pulled (`ollama pull llama3.2`).
# Defaults to the Low tier's model from src/utils/constants/models.ts.
BUBBLENER_OLLAMA_MODEL=
